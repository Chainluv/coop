{
  "name": "coop",
  "version": "0.1.0",
  "private": true,
  "description": "CO-OP — a gamified collaboration arena for music artists",
  "main": "server/index.js",
  "scripts": {
    "start": "node --no-warnings server/index.js",
    "dev": "node --no-warnings --watch server/index.js",
    "reset": "rm -rf data/*.db* data/uploads && node --no-warnings server/index.js",
    "audio": "node scripts/gen-audio.js",
    "test": "node --no-warnings --test test/*.test.js"
  },
  "engines": { "node": ">=22.5" },
  "dependencies": {
    "express": "^5.1.0",
    "multer": "^2.0.2"
  }
}
